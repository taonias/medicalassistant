# Production environment for docker-compose.prod.yml.
# Copy to `.env.prod` next to docker-compose.prod.yml on the VM and fill in real values.
# Everything marked REQUIRED must be set or `docker compose` will refuse to start.

# --- Domain / TLS (REQUIRED) ------------------------------------------------
# The domain whose DNS A record points at this VM. Used by nginx + Let's Encrypt.
DOMAIN=medical.example.com
# Email Let's Encrypt uses for expiry notices (used by init-letsencrypt.sh).
LETSENCRYPT_EMAIL=you@example.com

# --- Image coordinates ------------------------------------------------------
# Must match what package-release.ps1 tags/saves. Defaults are fine.
IMAGE_PREFIX=medicalassistant
IMAGE_TAG=latest

# --- Database (REQUIRED) ----------------------------------------------------
POSTGRES_APP_PASSWORD=change-me-strong-db-password

# --- RabbitMQ (REQUIRED) ----------------------------------------------------
RABBITMQ_BOOTSTRAP_USER=medicalassistant-broker-bootstrap
RABBITMQ_BOOTSTRAP_PASSWORD=change-me-strong-bootstrap-password
RABBITMQ_BACKEND_PASSWORD=change-me-strong-backend-password
RABBITMQ_WORKER_PASSWORD=change-me-strong-worker-password
RABBITMQ_CLINICAL_PASSWORD=change-me-strong-clinical-password

# --- First doctor account (recommended on a fresh deploy) -------------------
# Seeds an initial Doctor login on startup so you can sign in without an open
# registration endpoint. Idempotent: created only if it does not already exist,
# and the password of an existing user is NOT overwritten (change it in-app).
# Leave USERNAME/PASSWORD blank to disable seeding entirely.
SEED_DOCTOR_USERNAME=
SEED_DOCTOR_PASSWORD=
SEED_DOCTOR_EMAIL=
SEED_DOCTOR_FIRST_NAME=
SEED_DOCTOR_LAST_NAME=
# Set to true for ONE deploy to force the configured password back onto an
# existing seeded user (e.g. to recover from a lost password), then set back to false.
SEED_DOCTOR_RESET_PASSWORD=false

# --- App secrets (REQUIRED) -------------------------------------------------
# JWT signing key: use a long random string (>= 32 chars).
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# Shared secret between backend and clinical-knowledge (API auth + AI callbacks).
CLINICAL_KNOWLEDGE_API_KEY=change-me-clinical-api-key
CLINICAL_KNOWLEDGE_ADMIN_API_KEY=change-me-clinical-admin-key
AI_CALLBACK_API_KEY=change-me-ai-callback-key

# --- OpenAI (REQUIRED for chat/embeddings) ----------------------------------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# --- Transcription provider -------------------------------------------------
# AzureSpeech (default) or OpenAiWhisper. Fill in the matching keys.
TRANSCRIPTION_PROVIDER=AzureSpeech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_WHISPER_API_KEY=
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
OPENAI_WHISPER_BASE_URL=https://api.openai.com/v1

# --- Blob storage -----------------------------------------------------------
# Azurite in-container by default; override to a real Azure Storage connection string
# for durable/off-box blob storage.
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://azurite
