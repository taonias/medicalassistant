# One Postgres server hosts both databases (MedicalAssistantDb + ai_med),
# user "medicalassistant", with this password.
POSTGRES_APP_PASSWORD=replace-with-local-db-password
RABBITMQ_BOOTSTRAP_USER=medicalassistant-broker-bootstrap
RABBITMQ_BOOTSTRAP_PASSWORD=replace-with-local-rabbitmq-bootstrap-password
RABBITMQ_BACKEND_PASSWORD=replace-with-local-backend-rabbitmq-password
RABBITMQ_WORKER_PASSWORD=replace-with-local-worker-rabbitmq-password
CLINICAL_KNOWLEDGE_API_KEY=local-development-key
CLINICAL_KNOWLEDGE_ADMIN_API_KEY=local-development-admin-key
JWT_KEY=MedicalAssistantLocalDevelopmentJwtKey_ChangeMe_32chars
# Transcription provider: AzureSpeech (default) or OpenAiWhisper
TRANSCRIPTION_PROVIDER=AzureSpeech
# Azure Speech (used when TRANSCRIPTION_PROVIDER=AzureSpeech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# OpenAI Whisper (used when TRANSCRIPTION_PROVIDER=OpenAiWhisper)
OPENAI_WHISPER_API_KEY=
OPENAI_WHISPER_MODEL=gpt-4o-transcribe
# OpenAI for Clinical Knowledge chunking/summaries + embeddings.
# Embeddings model MUST stay text-embedding-3-large (3072 dims).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
BACKEND_OUTBOX_RELAY_BATCH_SIZE=25
BACKEND_OUTBOX_RELAY_LEASE_DURATION=00:02:00
BACKEND_OUTBOX_RELAY_POLL_INTERVAL=00:00:05
BACKEND_OUTBOX_RELAY_FAILURE_BACKOFF=00:00:30
TRANSCRIPTION_WORKER_MAX_CONCURRENT_TRANSCRIPTIONS=1
TRANSCRIPTION_WORKER_SHUTDOWN_DRAIN_TIMEOUT=00:00:30
TRANSCRIPTION_WORKER_PROCESSING_LEASE_DURATION=00:10:00
# Shared secret for AI → backend callbacks, including the chat-progress relay that
# powers the live "what the system is doing" line. Backend AiCallback:ApiKey and the
# AI service's BackendCallback:ApiKey both read this.
AI_CALLBACK_API_KEY=dev-callback-key
