{
  "Database": {
    "Provider": "PostgreSQL"
  },
  "ConnectionStrings": {
    "MedicalAssistantDatabasePostgreSQL": "Host=localhost;Port=5432;Database=MedicalAssistantDb;Username=postgres;Password=postgres",
    "MedicalAssistantDatabaseSqlServer": "Server=localhost;Database=MedicalAssistantDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Key": "MedicalAssistantSuperSecretKey_ChangeInProduction_32chars!",
    "Issuer": "MedicalAssistantApi",
    "Audience": "MedicalAssistantClient",
    "DurationInMinutes": 120
  },
  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=masaresources;AccountKey=TxN8OJW5sZd6cYh8M+MPRVujiiCGD/3+2EnXVI9B17+3PzUD/chIBJqqz+8t8gOsV8+eHQMA1EEk+AStl0CMGA==;EndpointSuffix=core.windows.net",
    "ConsultationAudioContainer": "audio",
    "ConsultationDocumentsContainer": "pdf"
  },
  "AiModule": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "dev-ai-module-key",
    "ApiBaseUrl": "https://localhost:7037"
  },
  "ClinicalKnowledge": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "local-development-key",
    "SubmitTimeoutSeconds": 10
  },
  "AiCallback": {
    "ApiKey": "dev-callback-key"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "backend-clinical-knowledge",
    "Password": "replace-with-backend-clinical-knowledge-rabbitmq-secret",
    "VirtualHost": "/",
    "ClientProvidedName": "backend-clinical-knowledge",
    "UseTls": false,
    "Consumer": {
      "QueueName": "medicalassistant.backend.transcript-ready",
      "PrefetchCount": 10,
      "ShutdownDrainTimeout": "00:00:30"
    },
    "Topology": {
      "ExchangeName": "medicalassistant.events",
      "SubscriberName": "backend-clinical-knowledge",
      "QueueName": "medicalassistant.backend.transcript-ready",
      "RetryDelays": [
        "00:00:10",
        "00:01:00",
        "00:05:00",
        "00:15:00",
        "01:00:00"
      ]
    },
    "Publisher": {
      "ExchangeName": "medicalassistant.events",
      "ConfirmTimeout": "00:00:05"
    }
  },
  "AppSettings": {
    "AllowedAudioContentTypes": [
      "audio/wav",
      "audio/mpeg",
      "audio/mp3",
      "audio/webm",
      "audio/ogg"
    ],
    "MaxAudioFileSizeBytes": 104857600,
    "AllowedDocumentContentTypes": ["application/pdf"],
    "MaxDocumentFileSizeBytes": 104857600
  },
  "EventRetention": {
    "OutboxRetention": "30.00:00:00",
    "InboxRetention": "30.00:00:00",
    "DeadLetterRetention": "14.00:00:00",
    "TombstoneRetention": "90.00:00:00"
  },
  "ConsultationOutboxRelay": {
    "Enabled": true,
    "BatchSize": 25,
    "LeaseDuration": "00:02:00",
    "PollInterval": "00:00:05",
    "FailureBackoff": "00:00:30"
  },
  "CorsSettings": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:5500"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
