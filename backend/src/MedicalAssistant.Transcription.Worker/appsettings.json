{
  "ConnectionStrings": {
    "MedicalAssistantDatabasePostgreSQL": ""
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "transcription-worker",
    "Password": "replace-with-transcription-worker-rabbitmq-secret",
    "VirtualHost": "/",
    "ClientProvidedName": "transcription-worker",
    "UseTls": false,
    "Consumer": {
      "QueueName": "medicalassistant.transcription-worker",
      "PrefetchCount": 1,
      "ShutdownDrainTimeout": "00:00:30"
    },
    "Topology": {
      "ExchangeName": "medicalassistant.events",
      "SubscriberName": "transcription-worker",
      "QueueName": "medicalassistant.transcription-worker",
      "RetryDelays": [
        "00:00:10",
        "00:01:00",
        "00:05:00",
        "00:15:00",
        "01:00:00"
      ]
    },
    "Publisher": {
      "ExchangeName": "medicalassistant.events",
      "ConfirmTimeout": "00:00:05"
    }
  },
  "TranscriptionWorker": {
    "ShutdownDrainTimeout": "00:00:30",
    "ProcessingLeaseDuration": "00:10:00",
    "MaxConcurrentTranscriptions": 1,
    "BlobRetrieval": {
      "ConnectionString": "",
      "ConsultationAudioContainer": "consultation-audio",
      "MaxBytes": 104857600,
      "AllowedContentTypes": [
        "audio/wav",
        "audio/mpeg",
        "audio/mp3",
        "audio/webm",
        "audio/ogg"
      ]
    },
    "AzureSpeech": {
      "Key": "",
      "Region": "",
      "LanguageCode": "en-US",
      "ApiVersion": "2025-10-15",
      "Timeout": "00:05:00",
      "Phrases": []
    }
  }
}
